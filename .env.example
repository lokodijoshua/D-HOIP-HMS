# Development-only placeholders. Never place real values in this file.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_clerk_secret_key

# Dedicated runtime role only. Never use a service-role key or a BYPASSRLS role.
# Remote TLS is required. Direct, session-pooler, and transaction-pooler URLs must each be validated.
DATABASE_URL=postgresql://dhoip_app:replace_with_password@replace_with_host:6543/postgres?sslmode=require

# Set to 1 only for a dedicated non-production database with the Stage B probe applied.
STAGE_B_LIVE_TESTS=0
